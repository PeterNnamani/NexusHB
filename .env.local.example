# ----------------------------------------------------------------------------
# Nexus Hub environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ----------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project URL and anon (public) key from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key (server-only, full DB access). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Paystack ---------------------------------------------------------------
# Public key is used in the browser checkout; secret key is server-only.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_or_test_xxx
PAYSTACK_SECRET_KEY=sk_live_or_test_xxx
# Optional override for the Paystack callback URL (defaults to APP_URL/payment/verify)
PAYSTACK_CALLBACK_URL=

# --- App URLs ---------------------------------------------------------------
# Public base URL of the deployed app (used for payment callbacks/redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI chatbot (Groq preferred, OpenAI fallback) ---------------------------
# Groq uses an OpenAI-compatible API. If neither key is set, the bot uses keyword fallbacks.
# Web search uses DuckDuckGo automatically (no extra API key) for current events & facts.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# Optional fallback:
OPENAI_API_KEY=your_openai_api_key

# --- Live Classroom (Jitsi) -------------------------------------------------
# Default public Jitsi server. For production, use your own Jitsi domain.
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# --- Course seeding ---------------------------------------------------------
# A secret token required to run the one-time /api/admin/seed-courses import.
SEED_SECRET=choose_a_long_random_string

# --- Platform admin (separate from student/tutor accounts) --------------------
# Operators sign in at /admin/login — not linked to Supabase user roles.
ADMIN_EMAIL=admin@yourdomain.com
# Quote passwords that contain # or other special characters
ADMIN_PASSWORD="choose_a_strong_password"
ADMIN_SESSION_SECRET=choose_a_long_random_string
